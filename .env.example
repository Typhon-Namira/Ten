TEN_ENVIRONMENT=development
TEN_LOG_LEVEL=INFO
TEN_DATABASE_URL=postgresql+asyncpg://ten:ten@postgres:5432/ten
TEN_CEREBRAS_API_KEY=
TEN_CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
TEN_CEREBRAS_MODEL=gpt-oss-120b
TEN_GROQ_API_KEY=
TEN_GROQ_BASE_URL=https://api.groq.com/openai/v1
TEN_GROQ_MODEL=llama-3.1-8b-instant
TEN_CORS_ORIGINS=["http://localhost:5173"]
VITE_API_URL=http://localhost:8000
TEN_INTEGRATION_ENABLED=true
TEN_LIVE_PIPELINE_ENABLED=true
# WARNING — read before deploying to Railway/production, not just copying this file verbatim:
# `false` here is the correct LOCAL DEV default (you don't want your laptop hammering external
# providers and running the full SMC-onward chain on every save). In production, Settings has an
# auto-enable safety net that flips both of these to `true` automatically — BUT ONLY if the
# variable is left completely UNSET. If you set `TEN_INTEGRATION_WORKER_ENABLED=false` /
# `TEN_MARKET_DATA_WORKER_ENABLED=false` explicitly in Railway (e.g. by copying this file
# wholesale into your Railway environment), that explicit `false` overrides the safety net
# permanently — the market data poller and/or the integration worker that drains its output into
# SMC/Liquidity/.../Signal Decision will never start. This is a completely silent failure mode:
# `/api/v1/system/diagnostics` will show these workers as "enabled": false rather than crashed, so
# check that field specifically if the pipeline looks stalled. For a real deployment, DELETE these
# two lines rather than setting them to `false`, so the auto-enable logic can do its job — or set
# them to `true` explicitly if you want to be certain regardless of environment detection.
TEN_INTEGRATION_WORKER_ENABLED=false
TEN_MARKET_DATA_WORKER_ENABLED=false
TEN_REPLAY_WORKER_ENABLED=false
# Market data: keyless public sources (LBMA/Kraken/OKX) are the default and require no key —
# see docs/MARKET_DATA_ENGINE.md. Only change this if you have manually re-enabled a legacy
# paid/keyed provider (twelve_data/oanda/alpha_vantage/financial_modeling_prep) in
# configs/market_data.yaml, or a robots.txt-blocked legacy adapter (yahoo_finance/stooq/binance) —
# see backend/app/engines/market_data_engine/adapters.py for why those three are never fetched
# from even if enabled.
TEN_MARKET_DATA_PROVIDER=lbma_gold_price
TEN_MARKET_DATA_SYMBOLS=["XAUUSD"]
TEN_MARKET_DATA_TIMEFRAMES=["M15"]
TEN_MARKET_DATA_BOOTSTRAP_ENABLED=true
TEN_MARKET_DATA_BOOTSTRAP_CANDLES=2500
TEN_MARKET_DATA_POLL_SECONDS=60
# Must exceed the largest configured timeframe's own bar duration with margin — see the comment
# on Settings.max_candle_staleness_seconds. 1800s = 2x the default M15 timeframe's 900s duration.
TEN_MAX_CANDLE_STALENESS_SECONDS=1800
# The following four are for the legacy, disabled-by-default paid market-data providers
# (configs/market_data.yaml sets enabled: false for all of them) — safe to leave unset unless you
# explicitly re-enable one.
TEN_TWELVE_DATA_API_KEY=
TEN_ALPHA_VANTAGE_API_KEY=
TEN_OANDA_API_KEY=
TEN_OANDA_ACCOUNT_ID=
# Economic calendar: the active provider set is keyless public sources (BLS/BEA/Fed/Census/
# DOL/ECB) — see docs and configs/economic_calendar.yaml. FMP/Finnhub below are legacy,
# disabled-by-default adapters kept only for backward compatibility; safe to leave unset.
TEN_FMP_API_KEY=
TEN_FINNHUB_API_KEY=
TEN_PUBLIC_READ_ACCESS=true
# JSON map of secret keys to viewer/operator/admin roles. Required in production.
TEN_API_KEYS={}
# AI-centric capabilities remain disabled unless explicitly enabled by an operator. A safe
# production rollout enables shadow state/forecast/proposals/monitoring while leaving
# publication and adjustments disabled until their existing eligibility policies approve them.
TEN_AI_CENTRIC_SHADOW_MODE=
TEN_AI_SIGNAL_PROPOSALS=
TEN_AI_SIGNAL_MONITORING=
TEN_AI_SIGNAL_PUBLICATION=
TEN_AI_SIGNAL_ADJUSTMENTS=
# Database retention worker (backend/app/core/database/retention.py) — deletes rows older than
# these windows from tables that would otherwise grow unbounded. Safe defaults; all optional.
TEN_RETENTION_WORKER_ENABLED=true
TEN_RETENTION_INTERVAL_SECONDS=3600
TEN_RETENTION_BATCH_SIZE=500
TEN_ANALYTICAL_OBJECT_RETENTION_DAYS=14
TEN_ANALYTICAL_SNAPSHOT_RETENTION_DAYS=14
TEN_INTEGRATION_AUDIT_RETENTION_DAYS=14
TEN_OPERATIONAL_SIGNAL_RETENTION_DAYS=180
TEN_MARKET_DATA_HISTORY_RETENTION_DAYS=7

