def seed_all(
    seed=SEED,
):
    random.seed(
        seed
    )

    np.random.seed(
        seed
    )

    torch.manual_seed(
        seed
    )

    if torch.cuda.is_available():
        torch.cuda.manual_seed_all(
            seed
        )


def realized_from_race(
    race,
    terminal,
):
    out = np.full(
        len(race),
        np.nan,
        dtype=np.float32,
    )

    out[
        race == 1
    ] = TP_VALUE

    out[
        race == 0
    ] = SL_VALUE

    m = (
        race == -1
    )

    out[m] = (
        terminal[m]
        - COST
    )

    return out


def window_ok(
    mask,
    source,
    seq,
):
    bad = (
        ~mask
    ).astype(
        np.int32
    )

    pref = np.concatenate(
        [
            [0],
            np.cumsum(
                bad,
                dtype=np.int64,
            ),
        ]
    )

    start = (
        source
        - seq
        + 1
    )

    good = (
        start >= 0
    )

    safe_start = np.clip(
        start,
        0,
        None,
    )

    bad_count = (
        pref[
            source + 1
        ]
        - pref[
            safe_start
        ]
    )

    return (
        good
        & (
            bad_count == 0
        )
    )


def contiguous_ok(
    timestamps,
    source,
    seq,
):
    bad = np.zeros(
        len(timestamps),
        dtype=np.int32,
    )

    bad[1:] = (
        np.diff(
            timestamps
        )
        != STEP_NS
    ).astype(
        np.int32
    )

    pref = np.concatenate(
        [
            [0],
            np.cumsum(
                bad,
                dtype=np.int64,
            ),
        ]
    )

    start = (
        source
        - seq
        + 1
    )

    good = (
        start >= 0
    )

    safe_start = np.clip(
        start,
        0,
        None,
    )

    bad_edges = (
        pref[
            source + 1
        ]
        - pref[
            safe_start + 1
        ]
    )

    return (
        good
        & (
            bad_edges == 0
        )
    )


def chunked_norm(
    features,
    rows,
    chunk=50_000,
):
    total = np.zeros(
        features.shape[1],
        dtype=np.float64,
    )

    total2 = np.zeros(
        features.shape[1],
        dtype=np.float64,
    )

    n = 0

    for i in range(
        0,
        len(rows),
        chunk,
    ):
        r = rows[
            i:
            i + chunk
        ]

        x = np.asarray(
            features[r],
            dtype=np.float64,
        )

        total += x.sum(
            axis=0
        )

        total2 += np.square(
            x
        ).sum(
            axis=0
        )

        n += len(x)

    mean = (
        total
        / max(
            n,
            1,
        )
    )

    var = (
        total2
        / max(
            n,
            1,
        )
        - np.square(
            mean
        )
    )

    std = np.sqrt(
        np.maximum(
            var,
            1e-8,
        )
    )

    std[
        std < 1e-4
    ] = 1.0

    return (
        mean.astype(
            np.float32
        ),
        std.astype(
            np.float32
        ),
    )


def load_data():
    features = np.load(
        TECH_DIR
        / "technical_setup_features.npy",
        mmap_mode="r",
    )

    feature_valid = np.load(
        TECH_DIR
        / "technical_setup_valid.npy",
        mmap_mode="r",
    ).astype(
        bool
    )

    timestamps = np.load(
        TECH_DIR
        / "timestamps_ns.npy",
        mmap_mode="r",
    ).astype(
        np.int64
    )

    with open(
        TECH_DIR
        / "feature_names.json"
    ) as f:
        feature_names = json.load(
            f
        )

    with open(
        TECH_DIR
        / "metadata.json"
    ) as f:
        metadata = json.load(
            f
        )

    target = pd.read_parquet(
        TARGET_FILE
    )

    source = target[
        "source_row"
    ].to_numpy(
        np.int64
    )

    years = target[
        "year"
    ].to_numpy(
        np.int16
    )

    horizon_valid = (
        target[
            "horizon_valid"
        ].to_numpy(
            np.int8
        )
        == 1
    )

    long_race = target[
        "long_race_tp30_sl15"
    ].to_numpy(
        np.int8
    )

    short_race = target[
        "short_race_tp30_sl15"
    ].to_numpy(
        np.int8
    )

    long_terminal = target[
        "long_terminal_bps"
    ].to_numpy(
        np.float32
    )

    short_terminal = target[
        "short_terminal_bps"
    ].to_numpy(
        np.float32
    )

    long_pnl = (
        realized_from_race(
            long_race,
            long_terminal,
        )
    )

    short_pnl = (
        realized_from_race(
            short_race,
            short_terminal,
        )
    )

    pnl = np.column_stack(
        [
            long_pnl,
            short_pnl,
        ]
    ).astype(
        np.float32
    )

    race = np.column_stack(
        [
            long_race,
            short_race,
        ]
    ).astype(
        np.int8
    )

    valid_race = np.isin(
        race,
        [-1, 0, 1],
    ).all(
        axis=1
    )

    current_ok = (
        feature_valid[
            source
        ]
    )

    history_ok = window_ok(
        feature_valid,
        source,
        SEQ,
    )

    time_ok = contiguous_ok(
        timestamps,
        source,
        SEQ,
    )

    eligible = (
        horizon_valid
        & valid_race
        & np.isfinite(
            pnl
        ).all(
            axis=1
        )
        & current_ok
        & history_ok
        & time_ok
    )

    tp = (
        race == 1
    ).astype(
        np.float32
    )

    win = (
        pnl > 0
    ).astype(
        np.float32
    )

    action = np.zeros(
        len(target),
        dtype=np.int64,
    )

    choose_long = (
        (pnl[:, 0] > 0)
        & (
            pnl[:, 0]
            >= pnl[:, 1]
        )
    )

    choose_short = (
        (pnl[:, 1] > 0)
        & (
            pnl[:, 1]
            > pnl[:, 0]
        )
    )

    action[
        choose_long
    ] = 1

    action[
        choose_short
    ] = 2

    split = {
        "train":
            np.flatnonzero(
                eligible
                & (
                    years <= 2022
                )
            ),

        "val":
            np.flatnonzero(
                eligible
                & (
                    years >= 2023
                )
                & (
                    years <= 2024
                )
            ),

        "test2025":
            np.flatnonzero(
                eligible
                & (
                    years == 2025
                )
            ),

        "reserved2026":
            np.flatnonzero(
                eligible
                & (
                    years == 2026
                )
            ),
    }

    base_n = int(
        metadata.get(
            "base_v60_features",
            101,
        )
    )

    groups = {
        "base":
            list(
                range(
                    base_n
                )
            ),

        "m5":
            [],

        "m15":
            [],

        "h1":
            [],

        "h4":
            [],

        "setup":
            [],
    }

    for i, name in enumerate(
        feature_names[
            base_n:
        ],
        start=base_n,
    ):
        if name.startswith(
            "m5_"
        ):
            groups[
                "m5"
            ].append(
                i
            )

        elif name.startswith(
            "m15_"
        ):
            groups[
                "m15"
            ].append(
                i
            )

        elif name.startswith(
            "h1_"
        ):
            groups[
                "h1"
            ].append(
                i
            )

        elif name.startswith(
            "h4_"
        ):
            groups[
                "h4"
            ].append(
                i
            )

        else:
            groups[
                "setup"
            ].append(
                i
            )

    covered = sorted(
        i
        for ids
        in groups.values()
        for i
        in ids
    )

    if covered != list(
        range(
            len(
                feature_names
            )
        )
    ):
        raise RuntimeError(
            "Feature family partition "
            "is incomplete or overlapping"
        )

    norm_mean, norm_std = (
        chunked_norm(
            features,
            source[
                split[
                    "train"
                ]
            ],
        )
    )

    arrays = {
        "features":
            features,

        "source":
            source,

        "tp":
            tp,

        "win":
            win,

        "pnl":
            pnl,

        "action":
            action,

        "race":
            race,
    }

    return (
        arrays,
        split,
        groups,
        feature_names,
        norm_mean,
        norm_std,
    )


class TechnicalDataset(
    Dataset
):
    def __init__(
        self,
        rows,
        arrays,
        mean,
        std,
    ):
        self.rows = np.asarray(
            rows,
            dtype=np.int64,
        )

        self.a = arrays
        self.mean = mean
        self.std = std

    def __len__(
        self,
    ):
        return len(
            self.rows
        )

    def __getitem__(
        self,
        i,
    ):
        r = int(
            self.rows[i]
        )

        source = int(
            self.a[
                "source"
            ][r]
        )

        seq = np.asarray(
            self.a[
                "features"
            ][
                source
                - SEQ
                + 1:
                source
                + 1
            ],
            dtype=np.float32,
        )

        seq = (
            seq
            - self.mean
        ) / self.std

        current = (
            seq[-1]
            .copy()
        )

        return (
            torch.from_numpy(
                seq
            ),

            torch.from_numpy(
                current
            ),

            torch.from_numpy(
                self.a[
                    "tp"
                ][r].copy()
            ),

            torch.from_numpy(
                self.a[
                    "win"
                ][r].copy()
            ),

            torch.tensor(
                self.a[
                    "action"
                ][r],
                dtype=torch.long,
            ),

            torch.from_numpy(
                self.a[
                    "pnl"
                ][r].copy()
            ),
        )


def make_loader(
    rows,
    shuffle,
    arrays,
    mean,
    std,
):
    ds = TechnicalDataset(
        rows,
        arrays,
        mean,
        std,
    )

    return DataLoader(
        ds,
        batch_size=BATCH,
        shuffle=shuffle,
        num_workers=WORKERS,
        pin_memory=True,
        persistent_workers=(
            WORKERS > 0
        ),
        drop_last=shuffle,
    )


class FamilyEncoder(
    nn.Module
):
    def __init__(
        self,
        dim,
        out_dim=64,
    ):
        super().__init__()

        hidden = max(
            64,
            min(
                192,
                dim * 2,
            ),
        )

        self.norm = nn.LayerNorm(
            dim
        )

        self.gate = nn.Linear(
            dim,
            dim,
        )

        self.net = nn.Sequential(
            nn.Linear(
                dim,
                hidden,
            ),
            nn.GELU(),
            nn.Dropout(
                0.08
            ),
            nn.Linear(
                hidden,
                out_dim,
            ),
            nn.GELU(),
        )

    def forward(
        self,
        x,
    ):
        z = self.norm(
            x
        )

        z = (
            z
            * torch.sigmoid(
                self.gate(
                    z
                )
            )
        )

        return self.net(
            z
        )


class TemporalBlock(
    nn.Module
):
    def __init__(
        self,
        channels,
        dilation,
    ):
        super().__init__()

        self.net = nn.Sequential(
            nn.Conv1d(
                channels,
                channels,
                3,
                padding=dilation,
                dilation=dilation,
            ),
            nn.GELU(),
            nn.BatchNorm1d(
                channels
            ),
            nn.Dropout(
                0.08
            ),
            nn.Conv1d(
                channels,
                channels,
                1,
            ),
        )

        self.norm = nn.BatchNorm1d(
            channels
        )

    def forward(
        self,
        x,
    ):
        return F.gelu(
            self.norm(
                x
                + self.net(
                    x
                )
            )
        )


