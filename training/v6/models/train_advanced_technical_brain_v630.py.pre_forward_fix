def class_weights(
    arr,
):
    counts = np.bincount(
        arr,
        minlength=3,
    ).astype(
        np.float64
    )

    weight = (
        counts.sum()
        / np.maximum(
            counts,
            1.0,
        )
    )

    weight = (
        weight
        / weight.mean()
    )

    return torch.tensor(
        weight,
        dtype=torch.float32,
    )


def bce_pos_weight(
    y,
):
    positive = y.sum(
        axis=0
    ).astype(
        np.float64
    )

    negative = (
        len(y)
        - positive
    )

    weight = (
        negative
        / np.maximum(
            positive,
            1.0,
        )
    )

    return torch.tensor(
        weight,
        dtype=torch.float32,
    )


def train_epoch(
    model,
    loader,
    optimizer,
    device,
    tp_pos_weight,
    win_pos_weight,
    action_weight,
):
    model.train()

    total = 0.0
    count = 0

    for (
        seq,
        current,
        tp,
        win,
        action,
        pnl,
    ) in loader:

        seq = seq.to(
            device,
            non_blocking=True,
        )

        current = current.to(
            device,
            non_blocking=True,
        )

        tp = tp.to(
            device,
            non_blocking=True,
        )

        win = win.to(
            device,
            non_blocking=True,
        )

        action = action.to(
            device,
            non_blocking=True,
        )

        pnl = pnl.to(
            device,
            non_blocking=True,
        )

        out = model(
            seq,
            current,
        )

        loss_tp = (
            F.binary_cross_entropy_with_logits(
                out[
                    "tp"
                ],
                tp,
                pos_weight=tp_pos_weight,
            )
        )

        loss_win = (
            F.binary_cross_entropy_with_logits(
                out[
                    "win"
                ],
                win,
                pos_weight=win_pos_weight,
            )
        )

        loss_action = (
            F.cross_entropy(
                out[
                    "action"
                ],
                action,
                weight=action_weight,
            )
        )

        pnl_diff = (
            pnl[:, 0]
            - pnl[:, 1]
        )

        pair_mask = (
            torch.abs(
                pnl_diff
            )
            >= 2.0
        )

        if pair_mask.any():
            pair_target = (
                pnl_diff[
                    pair_mask
                ]
                > 0
            ).float()

            pair_logit = (
                out[
                    "quality"
                ][
                    pair_mask,
                    0
                ]
                - out[
                    "quality"
                ][
                    pair_mask,
                    1
                ]
            )

            loss_side = (
                F.binary_cross_entropy_with_logits(
                    pair_logit,
                    pair_target,
                )
            )

        else:
            loss_side = (
                out[
                    "quality"
                ].sum()
                * 0.0
            )

        loss_quality = (
            F.binary_cross_entropy_with_logits(
                out[
                    "quality"
                ],
                win,
            )
        )

        loss = (
            1.00
            * loss_tp

            + 0.45
            * loss_win

            + 0.20
            * loss_action

            + 0.20
            * loss_side

            + 0.15
            * loss_quality
        )

        optimizer.zero_grad(
            set_to_none=True
        )

        loss.backward()

        torch.nn.utils.clip_grad_norm_(
            model.parameters(),
            2.0,
        )

        optimizer.step()

        total += (
            float(
                loss.item()
            )
            * len(
                seq
            )
        )

        count += len(
            seq
        )

    return (
        total
        / max(
            count,
            1,
        )
    )


@torch.no_grad()
def predict(
    model,
    loader,
    device,
):
    model.eval()

    result = {
        "tp": [],
        "win": [],
        "quality": [],
        "action": [],
        "pnl": [],
        "tp_true": [],
        "family_weights": [],
        "pair_weights": [],
    }

    for (
        seq,
        current,
        tp,
        win,
        action,
        pnl,
    ) in loader:

        seq = seq.to(
            device,
            non_blocking=True,
        )

        current = current.to(
            device,
            non_blocking=True,
        )

        pred = model(
            seq,
            current,
        )

        for key in (
            "tp",
            "win",
            "quality",
            "action",
        ):
            result[
                key
            ].append(
                pred[
                    key
                ].cpu().numpy()
            )

        result[
            "pnl"
        ].append(
            pnl.numpy()
        )

        result[
            "tp_true"
        ].append(
            tp.numpy()
        )

        result[
            "family_weights"
        ].append(
            pred[
                "family_weights"
            ].cpu().numpy()
        )

        result[
            "pair_weights"
        ].append(
            pred[
                "pair_weights"
            ].cpu().numpy()
        )

    for key in result:
        result[
            key
        ] = np.concatenate(
            result[
                key
            ],
            axis=0,
        )

    return result


def profit_factor(
    x,
):
    gains = x[
        x > 0
    ].sum()

    losses = -x[
        x < 0
    ].sum()

    if losses <= 0:
        return np.inf

    return float(
        gains
        / losses
    )


def safe_auc(
    y,
    score,
):
    try:
        return float(
            roc_auc_score(
                y,
                score,
            )
        )

    except ValueError:
        return np.nan


def safe_ap(
    y,
    score,
):
    try:
        return float(
            average_precision_score(
                y,
                score,
            )
        )

    except ValueError:
        return np.nan


def evaluate(
    name,
    pred,
    group_names,
    pairs,
):
    tp_prob = torch.sigmoid(
        torch.from_numpy(
            pred[
                "tp"
            ]
        )
    ).numpy()

    score = (
        pred[
            "tp"
        ]

        + 0.35
        * pred[
            "win"
        ]

        + 0.20
        * pred[
            "quality"
        ]
    )

    long_side = (
        score[:, 0]
        >= score[:, 1]
    )

    selected_score = np.where(
        long_side,
        score[:, 0],
        score[:, 1],
    )

    selected_pnl = np.where(
        long_side,
        pred[
            "pnl"
        ][:, 0],
        pred[
            "pnl"
        ][:, 1],
    )

    selected_tp = np.where(
        long_side,
        pred[
            "tp_true"
        ][:, 0],
        pred[
            "tp_true"
        ][:, 1],
    )

    print()
    print(
        name
    )

    print(
        "-" * 118
    )

    for side, idx in (
        (
            "LONG",
            0,
        ),
        (
            "SHORT",
            1,
        ),
    ):
        print(
            f"{side:<5} "
            f"TP_AP="
            f"{safe_ap(pred['tp_true'][:, idx], tp_prob[:, idx]):.4f} "
            f"TP_AUC="
            f"{safe_auc(pred['tp_true'][:, idx], tp_prob[:, idx]):.4f}"
        )

    means = []

    for coverage in (
        5.0,
        2.0,
        1.0,
        0.5,
    ):
        n = max(
            1,
            int(
                round(
                    len(
                        selected_score
                    )
                    * coverage
                    / 100.0
                )
            ),
        )

        idx = np.argpartition(
            selected_score,
            -n,
        )[
            -n:
        ]

        pnl = selected_pnl[
            idx
        ]

        tp_rate = (
            selected_tp[
                idx
            ].mean()
        )

        win_rate = (
            pnl > 0
        ).mean()

        pf = profit_factor(
            pnl
        )

        long_share = (
            long_side[
                idx
            ].mean()
        )

        means.append(
            float(
                pnl.mean()
            )
        )

        print(
            f"{coverage:>4.1f}% "
            f"n={n:>5} "
            f"TP={tp_rate:>6.2%} "
            f"WIN={win_rate:>6.2%} "
            f"mean={pnl.mean():>+7.3f} "
            f"PF={pf:>6.3f} "
            f"LONG={long_share:>6.2%}"
        )

    utility = (
        0.40
        * means[0]

        + 0.35
        * means[1]

        + 0.25
        * means[2]
    )

    print(
        "STABLE UTILITY:",
        f"{utility:+.4f}",
    )

    family_weight = (
        pred[
            "family_weights"
        ].mean(
            axis=0
        )
    )

    family_rank = sorted(
        zip(
            group_names,
            family_weight,
        ),
        key=lambda x: x[1],
        reverse=True,
    )

    print(
        "Family attention:",
        ", ".join(
            f"{n}={w:.3f}"
            for n, w
            in family_rank
        ),
    )

    pair_weight = (
        pred[
            "pair_weights"
        ].mean(
            axis=0
        )
    )

    top_pair_idx = np.argsort(
        pair_weight
    )[
        -5:
    ][
        ::-1
    ]

    pair_text = []

    for k in top_pair_idx:
        i, j = pairs[k]

        pair_text.append(
            f"{group_names[i]}"
            f"x"
            f"{group_names[j]}"
            f"={pair_weight[k]:.3f}"
        )

    print(
        "Top interactions:",
        ", ".join(
            pair_text
        ),
    )

    return utility


